# =============================================================================
# Winners Team — environment variables
# Copy to .env.local for development. In Vercel, set these under
# Project → Settings → Environment Variables. NEVER commit real values.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL and the public anon / publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service-role (secret) key — SERVER ONLY. Used for Auth admin calls (invitations,
# blocking removed accounts) and scheduled jobs. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed app (used in e-mail links and redirects).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Scheduled jobs (required in production) ---------------------------------
# Random string of 32+ characters. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# --- AI provider for LEX and service-update summaries (optional) -------------
# AI_PROVIDER=gemini (free tier at aistudio.google.com) or anthropic (Claude).
# Without a key, LEX answers from the knowledge base and summaries are skipped.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# --- E-mail notifications via Resend (optional) ------------------------------
# Auth e-mails (verification, invitations, password reset) are sent by Supabase
# Auth — configure SMTP under Supabase → Authentication → SMTP.
RESEND_API_KEY=
EMAIL_FROM="Winners Team <notifications@your-domain.example>"

# --- Browser push notifications (optional) -----------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
